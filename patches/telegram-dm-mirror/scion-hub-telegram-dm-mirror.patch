+// distributed under the License is distributed on an "AS IS" BASIS,
+// WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+// See the License for the specific language governing permissions and
+// limitations under the License.
+
+package hub
+
+// Telegram DM mirror (local patch, experiment hub.telegram_dm_mirror).
+//
+// A user's Telegram messages to an agent are stored with channel "telegram"
+// in the same direct conversation as the native web DM, but the web DM view
+// only reads channel "web" (G3-d). With the experiment on:
+//   - the web DM view reads {web, telegram} rows of DM conversations, and
+//     telegram rows are pushed live on the DM subject with the DM key;
+//   - web-stored agent replies and web-typed user messages are copied to the
+//     Telegram spoke as observer-only messages on the agent topic, so no
+//     extra row is stored (deliverToAgent skips ObserverOnly).
+// With the experiment off every path behaves exactly as upstream.
+
+import (
+	"context"
+	"slices"
+	"strings"
+	"time"
+
+	"github.com/GoogleCloudPlatform/scion/pkg/experiments"
+	"github.com/GoogleCloudPlatform/scion/pkg/messages"
+	"github.com/GoogleCloudPlatform/scion/pkg/messaging"
+	"github.com/GoogleCloudPlatform/scion/pkg/store"
+)
+
+const (
+	tgMirrorChannel = "telegram"
+	// Metadata keys the Telegram plugin uses to recognize and label mirror
+	// copies. The plugin patch defines the same literals.
+	tgMirrorOriginKey     = "mirror_origin"
+	tgMirrorSenderNameKey = "sender_display_name"
+)
+
+// tgMirrorDMChannels is the channel set the web DM view reads while the mirror
+// is on. Other external channels (discord) and NULL-channel notices stay hidden.
+var tgMirrorDMChannels = []string{"web", tgMirrorChannel}
+
+func (s *Server) telegramDMMirrorEnabled() bool {
+	return s.experimentEnabled(experiments.TelegramDMMirror)
+}
+
+// nativeDMScope is nativeDMMessageScope, widened to tgMirrorDMChannels while
+// the mirror is on.
+func (s *Server) nativeDMScope() store.LatestMessageOptions {
+	if !s.telegramDMMirrorEnabled() {
+		return nativeDMMessageScope
+	}
+	return store.LatestMessageOptions{Channels: tgMirrorDMChannels, ExcludeType: nativeDMMessageScope.ExcludeType}
+}
+
+// filterAllowsChannel reports whether a message on channel ch would match the
+// channel constraint of f.
+func filterAllowsChannel(f store.MessageFilter, ch string) bool {
+	if len(f.Channels) > 0 {
+		return slices.Contains(f.Channels, ch)
+	}
+	return f.Channel == "" || f.Channel == ch
+}
+
+// tgMirrorableType limits mirroring to conversational messages; notices
+// (input-needed, state-change, system) already reach Telegram on their own.
+func tgMirrorableType(t string) bool {
+	switch t {
+	case messages.TypeInstruction, messages.TypeChat, messages.TypeReply:
+		return true
+	}
+	return false
+}
+
+func isDirectDMConversation(conv *messaging.ConversationResult) bool {
+	return conv != nil && conv.Kind == "direct" && validDMKey(conv.ExternalRef)
+}
+
+// telegramInboundDMKey returns the DM key for an inbound telegram row that was
+// filed in a direct DM conversation, or "" when the row is not one or the
+// mirror is off.
+func (s *Server) telegramInboundDMKey(m *store.Message, conv *messaging.ConversationResult, senderUserID string) string {
+	if m == nil || m.Channel != tgMirrorChannel || m.ThreadID != "" || senderUserID == "" || !isDirectDMConversation(conv) {
+		return ""
+	}
+	if !s.telegramDMMirrorEnabled() {
+		return ""
+	}
+	return conv.ExternalRef
+}
+
+// agentReplyMirrorsToTelegram reports whether an agent-to-user message stored
+// on the web channel of a direct DM conversation should be copied to Telegram.
+// Replies already routed to telegram by reply affinity are not copied again.
+func (s *Server) agentReplyMirrorsToTelegram(m *messages.StructuredMessage, conv *messaging.ConversationResult) bool {
+	if m == nil || m.Channel != "web" || !strings.HasPrefix(m.Recipient, "user:") ||
+		m.Broadcasted || m.ObserverOnly || !tgMirrorableType(m.Type) || !isDirectDMConversation(conv) {
+		return false
+	}
+	return s.telegramDMMirrorEnabled()
+}
+
+// mirrorToTelegram publishes an observer-only copy of m to the Telegram spoke
+// on the agent topic of agentSlug. It returns immediately: the plugin call
+// blocks until Telegram accepts the message, so it runs in the background and
+// failures are only logged. m is taken by value and given a fresh Metadata map,
+// so the copy shares no mutable state with the caller's message.
+func (s *Server) mirrorToTelegram(ctx context.Context, projectID, agentSlug string, m messages.StructuredMessage, createdAt time.Time, meta map[string]string) {
+	bp := s.GetMessageBrokerProxy()
+	if bp == nil || projectID == "" || agentSlug == "" || !tgMirrorableType(m.Type) {
+		return
+	}
+	m.Channel = tgMirrorChannel
+	m.ObserverOnly = true
+	m.ThreadID = ""
+	m.ConversationID = ""
+	m.ConversationAsserted = false
+	m.DeliveryText = ""
+	if !createdAt.IsZero() {
+		// The plugin dedups on sender|recipient|timestamp|type|msg.
+		m.Timestamp = createdAt.UTC().Format(time.RFC3339Nano)
+	}
+	md := make(map[string]string, len(meta))
+	for k, v := range meta {
+		md[k] = v
+	}
+	m.Metadata = md
+
+	logger := s.messageLog
+	go func() {
+		pctx, cancel := context.WithTimeout(context.WithoutCancel(ctx), brokerCallbackTimeout)
+		defer cancel()
+		if err := bp.PublishChannelMirror(pctx, projectID, agentSlug, &m); err != nil {
+			logger.Warn("Telegram DM mirror publish failed",
+				"project_id", projectID, "agent_slug", agentSlug, "sender", m.Sender, "error", err)
+		}
+	}()
+}
