+func TestTelegramDMMirror_BrokerInbound(t *testing.T) {
+	for _, enabled := range []bool{false, true} {
+		t.Run(fmt.Sprintf("mirror=%t", enabled), func(t *testing.T) {
+			srv, s := testServer(t)
+			ctx := context.Background()
+			sfx := fmt.Sprint(enabled)
+
+			db := openTestMemorySQLite(t, "sqlite")
+			wcs := NewWebChatStore(db, "sqlite")
+			require.NoError(t, wcs.Init())
+			srv.SetWebChatStore(wcs)
+			srv.SetDispatcher(&brokerMockDispatcher{})
+			setTelegramDMMirror(t, srv, enabled)
+			spy := &readStateAtPublishSpy{wcs: wcs}
+			srv.SetEventPublisher(spy)
+
+			user := &store.User{
+				ID: tid("tgm-inbound-user-" + sfx), Email: "tgm-inbound-" + sfx + "@example.com",
+				DisplayName: "Telegram User", Role: store.UserRoleMember, Status: "active", Created: time.Now(),
+			}
+			require.NoError(t, s.CreateUser(ctx, user))
+			ensureHubMembership(ctx, s, user.ID)
+			project := &store.Project{
+				ID: tid("tgm-inbound-proj-" + sfx), Slug: "tgm-inbound-" + sfx, Name: "Telegram Inbound",
+				OwnerID: user.ID, CreatedBy: user.ID, Created: time.Now(), Updated: time.Now(),
+			}
+			require.NoError(t, s.CreateProject(ctx, project))
+			srv.seedProjectCreatorMembership(ctx, project)
+			msgAuthzAddProjectMember(t, s, user.ID, project.ID, project.Slug, store.GroupMemberRoleMember)
+			agent := &store.Agent{
+				ID: tid("tgm-inbound-agent-" + sfx), Slug: "tgm-agent", Name: "Telegram Agent", ProjectID: project.ID,
+				Phase: string(state.PhaseRunning), MessageMode: store.MessageModeProject, StateVersion: 1,
+				Created: time.Now(), Updated: time.Now(),
+			}
+			require.NoError(t, s.CreateAgent(ctx, agent))
+			dmKey := makeDMKey(agent.ID, user.ID)
+
+			// As the Telegram plugin sends a group message: channel
+			// telegram, no thread key, chat id in metadata.
+			body, err := json.Marshal(inboundMessageRequest{
+				Topic: "scion.project." + project.ID + ".agent." + agent.Slug + ".messages",
+				Message: &messages.StructuredMessage{
+					Version: messages.Version, Timestamp: time.Now().UTC().Format(time.RFC3339),
+					Channel: tgMirrorChannel, Sender: "user:" + user.Email, Recipient: "agent:" + agent.Slug,
+					Msg: "hello from telegram", Type: messages.TypeInstruction,
+					Metadata: map[string]string{"telegram_chat_id": "-100", "telegram_message_id": "7"},
+				},
+			})
+			require.NoError(t, err)
+			req := httptest.NewRequest(http.MethodPost, "/api/v1/broker/inbound", bytes.NewReader(body))
+			req.Header.Set("Content-Type", "application/json")
+			req = req.WithContext(contextWithBrokerIdentity(req.Context(), NewBrokerIdentity("test-broker")))
+			rec := httptest.NewRecorder()
+			srv.mux.ServeHTTP(rec, req)
+			require.Equal(t, http.StatusOK, rec.Code, "body: %s", rec.Body.String())
+
+			res, err := s.ListMessages(ctx, store.MessageFilter{AgentID: agent.ID}, store.ListOptions{Limit: 10})
+			require.NoError(t, err)
+			require.Len(t, res.Items, 1)
+			persisted := res.Items[0]
+			assert.Empty(t, persisted.ThreadID, "the stored row keeps an empty thread key")
+			conv, err := s.GetConversationByExternalRef(ctx, "native", dmKey)
+			require.NoError(t, err)
+			assert.Equal(t, conv.ID, persisted.ConversationID, "filed in the native DM conversation")
+
+			require.True(t, spy.called)
+			rs, err := wcs.GetReadState(ctx, user.ID, dmKey)
+			require.NoError(t, err)
+			if !enabled {
+				assert.Empty(t, spy.lastMessageIDAtPublish, "stock: the live event carries no DM key")
+				assert.Nil(t, rs)
+				return
+			}
+			assert.Equal(t, persisted.ID, spy.lastMessageIDAtPublish,
+				"the live event carries the DM key and the DM watermark is already current")
+			assert.False(t, spy.hasUnreadAtPublish, "the sender's own Telegram message is not unread for them")
+			require.NotNil(t, rs)
+			assert.Equal(t, persisted.ID, rs.LastReadMessageID)
+		})
+	}
+}
