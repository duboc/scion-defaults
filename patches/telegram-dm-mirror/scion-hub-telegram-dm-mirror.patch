+func TestTelegramDMMirror_LiveDMSubject(t *testing.T) {
+	for _, enabled := range []bool{false, true} {
+		t.Run(fmt.Sprintf("mirror=%t", enabled), func(t *testing.T) {
+			srv, _ := testServer(t)
+			setTelegramDMMirror(t, srv, enabled)
+			pub := NewChannelEventPublisher()
+			t.Cleanup(pub.Close)
+			srv.SetEventPublisher(pub)
+
+			agentID, userID := tid(fmt.Sprintf("tgm-live-agent-%t", enabled)), tid(fmt.Sprintf("tgm-live-user-%t", enabled))
+			key := makeDMKey(agentID, userID)
+			ch, unsub := pub.Subscribe("user." + userID + ".chat.dm")
+			t.Cleanup(unsub)
+
+			for _, channel := range []string{"discord", tgMirrorChannel, "web"} {
+				pub.PublishUserMessage(context.Background(), &store.Message{
+					ID: tid("tgm-live-" + channel + fmt.Sprint(enabled)), AgentID: agentID,
+					Sender: "user:u@example.com", SenderID: userID, Recipient: "agent:a", RecipientID: agentID,
+					Msg: channel, Type: messages.TypeInstruction, Channel: channel, ThreadID: key, CreatedAt: time.Now(),
+				}, nil, nil)
+			}
+
+			// "web" is published last and is always pushed: once it arrives,
+			// everything that will arrive has.
+			var got []string
+			deadline := time.After(5 * time.Second)
+			for len(got) == 0 || got[len(got)-1] != "web" {
+				select {
+				case evt := <-ch:
+					var payload UserMessageEvent
+					require.NoError(t, json.Unmarshal(evt.Data, &payload))
+					got = append(got, payload.Channel)
+				case <-deadline:
+					t.Fatalf("timed out; got %v", got)
+				}
+			}
+			want := []string{"web"}
+			if enabled {
+				want = []string{tgMirrorChannel, "web"}
+			}
+			assert.Equal(t, want, got)
+		})
+	}
+}
