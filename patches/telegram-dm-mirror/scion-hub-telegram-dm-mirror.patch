+func TestTelegramDMMirror_History(t *testing.T) {
+	for _, enabled := range []bool{false, true} {
+		t.Run(fmt.Sprintf("mirror=%t", enabled), func(t *testing.T) {
+			srv, s := testServer(t)
+			setTelegramDMMirror(t, srv, enabled)
+			rows := seedTGMirrorDM(t, s, fmt.Sprintf("tgm-hist-%t", enabled))
+
+			rec := doRequest(t, srv, http.MethodGet, "/api/v1/chat/conversations/"+rows.key+"/messages", nil)
+			require.Equal(t, http.StatusOK, rec.Code, rec.Body.String())
+			var hist chatHistoryResponse
+			require.NoError(t, json.Unmarshal(rec.Body.Bytes(), &hist))
+			got := map[string]bool{}
+			for _, m := range hist.Messages {
+				got[m.ID] = true
+			}
+			assert.True(t, got[rows.web])
+			assert.Equal(t, enabled, got[rows.telegram], "telegram rows show only with the mirror on")
+			assert.False(t, got[rows.discord], "other external channels stay hidden (G3-d)")
+			assert.False(t, got[rows.notice], "NULL-channel notices stay hidden")
