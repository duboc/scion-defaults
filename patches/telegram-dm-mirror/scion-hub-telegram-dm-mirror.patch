+			rec = doRequest(t, srv, http.MethodGet,
+				"/api/v1/chat/conversations/"+rows.key+"/messages?around="+rows.telegram, nil)
+			if enabled {
+				assert.Equal(t, http.StatusOK, rec.Code, rec.Body.String())
+			} else {
+				assert.Equal(t, http.StatusNotFound, rec.Code)
+			}
+		})
+	}
