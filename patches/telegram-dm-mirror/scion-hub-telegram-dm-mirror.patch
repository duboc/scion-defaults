+// PublishChannelMirror publishes an observer-only copy of a message on the
+// AGENT topic so that only the broker spoke named by msg.Channel acts on it.
+// The agent topic's in-process subscriber (deliverToAgent) skips ObserverOnly
+// messages, whereas the user topic's deliverToUser would persist a duplicate
+// row — so mirrors must never go through PublishUserMessage.
+func (p *MessageBrokerProxy) PublishChannelMirror(ctx context.Context, projectID, agentSlug string, msg *messages.StructuredMessage) error {
+	if msg == nil || !msg.ObserverOnly || msg.Channel == "" {
+		return errors.New("channel mirror must be observer-only and name a channel")
+	}
+	return p.bus.Publish(ctx, eventbus.TopicAgentMessages(projectID, agentSlug), msg)
+}
