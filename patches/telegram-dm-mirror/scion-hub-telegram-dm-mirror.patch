+func TestTelegramDMMirror_WebSend(t *testing.T) {
+	for _, enabled := range []bool{false, true} {
+		t.Run(fmt.Sprintf("mirror=%t", enabled), func(t *testing.T) {
+			srv, s, _, proj, _ := setupSendTest(t)
+			srv.SetDispatcher(&brokerMockDispatcher{})
+			setTelegramDMMirror(t, srv, enabled)
+
+			events := NewChannelEventPublisher()
+			t.Cleanup(events.Close)
+			tg := &recordingSpoke{}
+			fanout := eventbus.NewFanOutEventBus([]eventbus.NamedEventBus{
+				{Name: eventbus.InProcessBusName, Bus: eventbus.NewInProcessEventBus(slog.Default())},
+				{Name: tgMirrorChannel, Bus: tg},
+			}, slog.Default())
+			proxy := NewMessageBrokerProxy(fanout, s, events, func() AgentDispatcher { return nil }, slog.Default())
+			proxy.Start()
+			t.Cleanup(proxy.Stop)
+			srv.SetMessageBrokerProxy(proxy)
+
+			agent := interruptTestAgent(t, s, proj.ID, fmt.Sprintf("tgm-web-%t", enabled), "running")
+			dmKey := makeDMKey(agent.ID, DevUserID)
+			setDMConversationID(t, s, dmKey, proj.ID)
+
+			const body = "ping from the web"
+			rec := doRequest(t, srv, http.MethodPost, "/api/v1/chat/conversations/"+dmKey+"/messages",
+				map[string]interface{}{"content": body})
+			require.Equal(t, http.StatusCreated, rec.Code, rec.Body.String())
+			if enabled {
+				require.Eventually(t, func() bool { return tg.has(body) }, 5*time.Second, 20*time.Millisecond)
+			}
+			time.Sleep(200 * time.Millisecond)
+
+			copies := spokeCopies(tg, body)
+			if !enabled {
+				assert.Empty(t, copies)
+				return
+			}
+			require.Len(t, copies, 1)
+			c := copies[0]
+			assert.True(t, c.ObserverOnly)
+			assert.Equal(t, tgMirrorChannel, c.Channel)
+			assert.Equal(t, "web", c.Metadata[tgMirrorOriginKey])
+			_, hasName := c.Metadata[tgMirrorSenderNameKey]
+			assert.True(t, hasName, "the copy carries the sender's display name")
+			assert.True(t, strings.HasPrefix(c.Sender, "user:"), c.Sender)
+			assert.Equal(t, DevUserID, c.SenderID)
+			assert.Equal(t, "agent:"+agent.Slug, c.Recipient)
+			assert.Equal(t, 1, storedWithBody(t, s, agent.ID, body), "the mirror stores no extra row")
+		})
+	}
+}
