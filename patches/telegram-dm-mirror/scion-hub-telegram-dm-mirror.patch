+func TestTelegramDMMirror_AgentReply(t *testing.T) {
+	for _, enabled := range []bool{false, true} {
+		t.Run(fmt.Sprintf("mirror=%t", enabled), func(t *testing.T) {
+			f := newAssistantReplyFixture(t, true)
+			setTelegramDMMirror(t, f.srv, enabled)
+
+			const body = "deploy plan ready"
+			f.send(t, messages.TypeInstruction, body)
+			f.waitStored(t, body)
+			const question = "which branch?"
+			f.send(t, messages.TypeInputNeeded, question)
+			f.waitStored(t, question)
+			if enabled {
+				require.Eventually(t, func() bool { return f.telegram.has(body) }, 5*time.Second, 20*time.Millisecond)
+			}
+			time.Sleep(200 * time.Millisecond) // a stray second copy would have landed by now
+
+			for _, m := range spokeCopies(f.telegram, question) {
+				assert.Empty(t, m.Metadata[tgMirrorOriginKey], "notices are never mirrored")
+			}
+			copies := spokeCopies(f.telegram, body)
+			if !enabled {
+				assert.Empty(t, copies)
+				return
+			}
+			require.Len(t, copies, 1, "exactly one Telegram copy")
+			c := copies[0]
+			assert.True(t, c.ObserverOnly)
+			assert.Equal(t, tgMirrorChannel, c.Channel)
+			assert.Equal(t, "web", c.Metadata[tgMirrorOriginKey])
+			assert.True(t, strings.HasPrefix(c.Recipient, "user:"), c.Recipient)
+			assert.Empty(t, c.ThreadID)
+			assert.Empty(t, c.ConversationID)
+			assert.False(t, f.teams.has(body), "the copy goes to the telegram spoke only")
+			assert.Equal(t, 1, storedWithBody(t, f.s, f.agent.ID, body), "the mirror stores no extra row")
+		})
+	}
+}
