+)
+
+// setTelegramDMMirror installs operational settings with the conversation
+// envelope switch on (the production default) and hub.telegram_dm_mirror set.
+func setTelegramDMMirror(t *testing.T, srv *Server, enabled bool) {
+	t.Helper()
+	fakeStore := newFakeHubSettingStore()
+	fakeStore.seed("messaging", json.RawMessage(`{"conversation_envelope_switch":true}`))
+	fakeStore.seed("experiments", json.RawMessage(fmt.Sprintf(`{"overrides":{%q:%t}}`, experiments.TelegramDMMirror, enabled)))
+	ops := NewOperationalSettings(fakeStore, emptyKoanf(), emptyKoanf())
+	_, err := ops.Refresh(context.Background())
+	require.NoError(t, err)
+	srv.SetOperationalSettings(ops)
+	require.True(t, srv.GetOperationalSettings().ConversationEnvelopeSwitch())
+	require.Equal(t, enabled, srv.telegramDMMirrorEnabled())
+}
+
+// spokeCopies returns the messages with the given body that r received.
+func spokeCopies(r *recordingSpoke, body string) []messages.StructuredMessage {
+	r.mu.Lock()
+	defer r.mu.Unlock()
+	var out []messages.StructuredMessage
+	for _, m := range r.msgs {
+		if m.Msg == body {
+			out = append(out, m)
+		}
+	}
+	return out
+}
+
+func storedWithBody(t *testing.T, s store.Store, agentID, body string) int {
+	t.Helper()
+	res, err := s.ListMessages(context.Background(), store.MessageFilter{AgentID: agentID}, store.ListOptions{Limit: 100})
+	require.NoError(t, err)
+	n := 0
+	for _, m := range res.Items {
+		if m.Msg == body {
+			n++
+		}
+	}
+	return n
+}
+
+// tgMirrorDMRows names the rows seedTGMirrorDM creates, oldest first.
+type tgMirrorDMRows struct {
+	key, web, telegram, discord, notice string
+}
+
+// seedTGMirrorDM seeds a DM conversation between DevUserID and an agent with
+// a web reply, a Telegram message stored the way broker inbound stores it (no
+// thread key), and newer discord and NULL-channel rows that must stay hidden.
+func seedTGMirrorDM(t *testing.T, s store.Store, name string) tgMirrorDMRows {
+	t.Helper()
+	ctx := context.Background()
+	projectID := rsProject(t, s, name+"-project")
+	agentID := rsAgent(t, s, name+"-agent", projectID)
+	key := makeDMKey(agentID, DevUserID)
+	convID := seedConversation(t, s, "native", key, "direct")
+	base := time.Now().UTC().Add(-time.Hour).Truncate(time.Second)
+
+	add := func(suffix, channel, typ, threadID string, fromUser bool, offset time.Duration) string {
+		m := &store.Message{
+			ID: tid(name + "-" + suffix), ProjectID: projectID, AgentID: agentID,
+			Sender: "agent:" + name + "-agent", SenderID: agentID,
+			Recipient: "user:" + DevUserID, RecipientID: DevUserID,
+			Msg: suffix, Type: typ, Channel: channel, ThreadID: threadID,
+			ConversationID: convID, CreatedAt: base.Add(offset),
+		}
+		if fromUser {
+			m.Sender, m.SenderID = "user:"+DevUserID, DevUserID
+			m.Recipient, m.RecipientID = "agent:"+name+"-agent", agentID
+		}
+		require.NoError(t, s.CreateMessage(ctx, m))
+		return m.ID
+	}
+	return tgMirrorDMRows{
+		key:      key,
+		web:      add("web", "web", messages.TypeInstruction, key, false, 0),
+		telegram: add("telegram", tgMirrorChannel, messages.TypeInstruction, "", true, time.Minute),
+		discord:  add("discord", "discord", messages.TypeInstruction, key, true, 2*time.Minute),
+		notice:   add("notice", "", messages.TypeInputNeeded, "", false, 3*time.Minute),
+	}
+}
