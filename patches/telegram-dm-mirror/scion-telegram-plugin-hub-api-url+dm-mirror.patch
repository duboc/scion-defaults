+// asHubMirror marks m the way the hub marks DM mirror copies.
+func asHubMirror(m *messages.StructuredMessage, senderName string) *messages.StructuredMessage {
+	m.ObserverOnly = true
+	m.Channel = "telegram"
+	m.Metadata = map[string]string{hubMirrorOriginKey: "web"}
+	if senderName != "" {
+		m.Metadata[hubMirrorSenderNameKey] = senderName
+	}
+	return m
+}
+
+func webMessageFrom(sender string) *messages.StructuredMessage {
+	return &messages.StructuredMessage{
+		Version:   messages.Version,
+		Timestamp: time.Now().Format(time.RFC3339Nano),
+		Sender:    sender,
+		Recipient: "agent:coder",
+		Msg:       "ping from the web",
+		Type:      messages.TypeInstruction,
+	}
+}
+
+func saveCoderContext(t *testing.T, store Store, chatID int64) {
+	t.Helper()
+	require.NoError(t, store.SaveConversationContext(context.Background(), &ConversationContext{
+		TelegramUserID: "456", ProjectID: "proj-1", AgentSlug: "coder", LastChatID: chatID, LastMessageAt: time.Now(),
+	}))
+}
+
+func sentChatIDs(tgSrv *fakeTGServerV2) []int64 {
+	var ids []int64
+	for _, m := range tgSrv.getSentMessages() {
+		ids = append(ids, m.ChatID)
+	}
+	return ids
+}
+
+// makePrivateGroup makes chatID look like a non-public supergroup whose only
+// members are the linked test user (456) and the bot.
+func makePrivateGroup(tgSrv *fakeTGServerV2, chatID int64) {
+	tgSrv.setChatMember(chatID, 456, "member")
+	tgSrv.setChatMemberCount(chatID, 2)
+	tgSrv.setChat(TGChat{ID: chatID, Type: "supergroup"})
+}
+
+// privacyCheckCalls returns the getChatMember, getChatMemberCount and getChat
+// call counts.
+func privacyCheckCalls(tgSrv *fakeTGServerV2) (member, count, chat int) {
+	member, _ = tgSrv.chatMemberStats()
+	return member, tgSrv.chatMemberCountCallCount(), tgSrv.getChatCallCount()
+}
