+func TestHubMirror_PrivacyCacheExpiry(t *testing.T) {
+	for name, tc := range map[string]struct {
+		entry     mirrorPrivacyEntry
+		wantCheck bool
+	}{
+		"answer within its TTL":  {entry: mirrorPrivacyEntry{checkedAt: time.Now().Add(-time.Minute)}},
+		"answer past its TTL":    {entry: mirrorPrivacyEntry{checkedAt: time.Now().Add(-mirrorPrivacyCacheTTL)}, wantCheck: true},
+		"failure within its TTL": {entry: mirrorPrivacyEntry{failed: true, checkedAt: time.Now().Add(-10 * time.Second)}},
+		"failure past its TTL":   {entry: mirrorPrivacyEntry{failed: true, checkedAt: time.Now().Add(-mirrorPrivacyFailureTTL)}, wantCheck: true},
+	} {
+		t.Run(name, func(t *testing.T) {
+			// Each cached entry says "not private" while the group is private,
+			// so the result shows whether the entry was reused.
+			b, tgSrv, _, _ := newDMScopeBroker(t)
+			makePrivateGroup(tgSrv, -300)
+			b.mirrorPrivacy = map[string]mirrorPrivacyEntry{mirrorPrivacyKey(-300, 456): tc.entry}
+
+			got := b.mirrorChatIsPrivate(context.Background(), b.api, -300, 456)
+
+			member, count, chat := privacyCheckCalls(tgSrv)
+			if tc.wantCheck {
+				assert.True(t, got, "the expired entry is re-checked")
+				assert.Equal(t, 1, member)
+				assert.Equal(t, 1, count)
+				assert.Equal(t, 1, chat)
+			} else {
+				assert.False(t, got, "the cached entry is reused")
+				assert.Zero(t, member)
+				assert.Zero(t, count)
+				assert.Zero(t, chat)
+			}
+		})
+	}
+}
