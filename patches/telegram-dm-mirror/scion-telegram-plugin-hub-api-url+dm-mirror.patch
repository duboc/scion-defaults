+func TestValidateHubAPIURL(t *testing.T) {
+	for _, raw := range []string{
+		"",
+		"https://hub.example.com",
+		"HTTPS://hub.example.com",
+		"https://hub.example.com:8443/prefix",
+		"http://localhost:8080",
+		"http://127.0.0.1",
+		"http://[::1]:8080",
+	} {
+		assert.NoError(t, validateHubAPIURL(raw), raw)
+	}
+
+	for _, raw := range []string{
+		"http://localhost.evil.com",
+		"http://localhost.evil.com:8080",
+		"http://10.0.0.5:8080",
+		"http://0.0.0.0:8080",
+		"http://hub.example.com",
+		"ftp://x",
+		"https://u:p@hub.example.com",
+		"https://u@hub.example.com",
+		"https://hub.example.com?x=1",
+		"https://hub.example.com?",
+		"https://hub.example.com#frag",
+		"https:hub.example.com",
+		"localhost:8080",
+		"//hub.example.com",
+		"::not a url",
+	} {
+		err := validateHubAPIURL(raw)
+		if assert.Error(t, err, raw) {
+			assert.Contains(t, err.Error(), "hub_api_url must be https, or http on a loopback host", raw)
+			assert.NotContains(t, err.Error(), raw, "the error names only the scheme and host")
+		}
+	}
+}
