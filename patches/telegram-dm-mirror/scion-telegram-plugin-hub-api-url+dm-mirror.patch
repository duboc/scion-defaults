+// GetChatMemberCount calls the getChatMemberCount API to retrieve the number
+// of members in a chat, bots included (local patch).
+func (c *TelegramAPIClient) GetChatMemberCount(ctx context.Context, chatID int64) (int, error) {
+	url := fmt.Sprintf("%s?chat_id=%d", c.methodURL("getChatMemberCount"), chatID)
+	req, err := http.NewRequestWithContext(ctx, "GET", url, nil)
+	if err != nil {
+		return 0, fmt.Errorf("create getChatMemberCount request: %w", err)
+	}
+
+	resp, err := c.httpClient.Do(req)
+	if err != nil {
+		return 0, fmt.Errorf("getChatMemberCount request failed: %w", c.redactToken(err))
+	}
+	defer resp.Body.Close()
+
+	var apiResp apiResponse
+	if err := json.NewDecoder(resp.Body).Decode(&apiResp); err != nil {
+		return 0, fmt.Errorf("decode getChatMemberCount response: %w", err)
+	}
+
+	if !apiResp.OK {
+		return 0, &APIError{Code: apiResp.ErrorCode, Description: apiResp.Description}
+	}
+
+	var count int
+	if err := json.Unmarshal(apiResp.Result, &count); err != nil {
+		return 0, fmt.Errorf("unmarshal getChatMemberCount result: %w", err)
+	}
+	return count, nil
+}
