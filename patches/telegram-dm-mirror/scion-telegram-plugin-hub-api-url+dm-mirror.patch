+			second := asHubMirror(webMessageFrom("user:alice@example.com"), "Alice")
+			second.Msg = "second ping from the web"
+			require.NoError(t, b.Publish(context.Background(), hubMirrorTestTopic, first))
+			require.NoError(t, b.Publish(context.Background(), hubMirrorTestTopic, second))
+
+			assert.Equal(t, tc.wantSent, sentChatIDs(tgSrv))
+			member, count, chat := privacyCheckCalls(tgSrv)
+			assert.Equal(t, 1, member, "getChatMember is called once within the cache TTL")
+			assert.Equal(t, 1, count, "getChatMemberCount is called once within the cache TTL")
+			assert.Equal(t, 1, chat, "getChat is called once within the cache TTL")
+		})
+	}
+}
