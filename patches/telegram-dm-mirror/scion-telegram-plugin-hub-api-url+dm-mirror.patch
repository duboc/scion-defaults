+// hub_api_url receives HMAC-signed requests and message text, so Configure
+// accepts only https, or http on a loopback host (local patch). A rejected
+// value leaves the previous setting in place.
+func TestV2_Configure_HubAPIURL(t *testing.T) {
+	const previous = "https://previous.example.com"
+	for _, tc := range []struct {
+		value   string
+		wantErr bool
+	}{
+		{"https://hub.example.com", false},
+		{"http://localhost:8080", false},
+		{"http://127.0.0.1:8080", false},
+		{"http://[::1]:8080", false},
+		{"", false},
+		{"http://10.0.0.5:8080", true},
+		{"http://hub.example.com", true},
+		{"ftp://x", true},
+		{"https://u:p@hub.example.com", true},
+		{"https://hub.example.com?x=1", true},
+		{"::not a url", true},
+		{"not a url", true},
+	} {
+		t.Run(tc.value, func(t *testing.T) {
+			tgSrv := newFakeTGServerV2(t)
+			config := func(hubAPIURL string) map[string]string {
+				return map[string]string{
+					"bot_token":    "test-token",
+					"api_base_url": tgSrv.srv.URL,
+					"hub_url":      "http://hub.test",
+					"hub_api_url":  hubAPIURL,
+					"broker_id":    "broker-test",
+					"db_path":      filepath.Join(t.TempDir(), "test.db"),
+				}
+			}
+			b := NewV2(slog.Default())
+			t.Cleanup(func() { b.Close() })
+			require.NoError(t, b.Configure(config(previous)))
+
+			err := b.Configure(config(tc.value))
+
+			b.mu.RLock()
+			got := b.hubAPIURL
+			b.mu.RUnlock()
+			if tc.wantErr {
+				require.Error(t, err)
+				assert.Contains(t, err.Error(), "hub_api_url must be https, or http on a loopback host (localhost, 127.0.0.1, ::1)")
+				assert.NotContains(t, err.Error(), tc.value, "the error names only the scheme and host")
+				assert.Equal(t, previous, got, "a rejected Configure keeps the previous hub_api_url")
+				return
+			}
+			require.NoError(t, err)
+			assert.Equal(t, tc.value, got)
+		})
+	}
+}
