+func TestHubMirror_UserWebMessage_GoesToContextChatAsUser(t *testing.T) {
+	b, tgSrv, hub, principal := newDMScopeBroker(t)
+	hub.userProjects = map[string][]ProjectOption{principal: {{ID: "proj-1"}}}
+	saveTestGroupLink(t, b.store, -200, "proj-1", "alpha", "")
+	saveTestGroupLink(t, b.store, -300, "proj-1", "alpha", "")
+	saveCoderContext(t, b.store, -300)
+	makePrivateGroup(tgSrv, -300)
+
+	require.NoError(t, b.Publish(context.Background(), hubMirrorTestTopic,
+		asHubMirror(webMessageFrom("user:alice@example.com"), "Alice")))
+
+	sent := tgSrv.getSentMessages()
+	require.Len(t, sent, 1)
+	assert.Equal(t, int64(-300), sent[0].ChatID)
+	assert.True(t, strings.HasPrefix(sent[0].Text, "👤 Alice (web) → 🤖 coder"), sent[0].Text)
+	assert.Contains(t, sent[0].Text, "ping from the web")
