+// apiBaseURL returns the base URL for plugin->hub API calls. Behind an IAP
+// proxy the public hub_url rejects the plugin's HMAC-signed requests, so
+// hub_api_url (e.g. http://localhost:8080 on a single-node hub) can point the
+// calls at the hub directly while links shown to users keep using hub_url.
+// Callers must hold b.mu.
+func (b *TelegramBrokerV2) apiBaseURL() string {
+	if b.hubAPIURL != "" {
+		return b.hubAPIURL
+	}
+	return b.hubURL
+}
+
+// hubAPIURLRule is the hub_api_url requirement quoted in validation errors.
+const hubAPIURLRule = "hub_api_url must be https, or http on a loopback host (localhost, 127.0.0.1, ::1)"
+
+// validateHubAPIURL checks a hub_api_url setting (local patch). The plugin
+// sends HMAC-signed requests and message text there, so it must be an https
+// URL, or an http URL on a loopback host, with no credentials, query or
+// fragment. Empty means unset. Errors name only the scheme and host, never
+// the whole value.
+func validateHubAPIURL(raw string) error {
+	if raw == "" {
+		return nil
+	}
+	u, err := url.Parse(raw)
+	if err != nil {
+		// err quotes the whole value; leave it out.
+		return fmt.Errorf("invalid hub_api_url: not a valid URL; %s", hubAPIURLRule)
+	}
+	scheme := strings.ToLower(u.Scheme)
+	switch {
+	case u.Host == "":
+		return fmt.Errorf("invalid hub_api_url: no host; %s", hubAPIURLRule)
+	case u.User != nil:
+		return fmt.Errorf("invalid hub_api_url (host %q): credentials are not allowed; %s", u.Host, hubAPIURLRule)
+	case u.RawQuery != "" || u.Fragment != "" || strings.ContainsAny(raw, "?#"):
+		// ContainsAny also catches a bare "?" or "#".
+		return fmt.Errorf("invalid hub_api_url (host %q): a query or fragment is not allowed; %s", u.Host, hubAPIURLRule)
+	case scheme == "https", scheme == "http" && transportauth.IsLoopbackHost(u.Hostname()):
+		return nil
+	}
+	return fmt.Errorf("invalid hub_api_url (scheme %q, host %q): %s", u.Scheme, u.Host, hubAPIURLRule)
+}
