+package telegram
+
+// Hub DM mirror copies (local patch, hub experiment hub.telegram_dm_mirror).
+//
+// The hub publishes observer-only copies of web DM traffic (agent replies and
+// the user's own web messages) on the agent topic, marked with mirror_origin.
+// They go only to the DM user's last chat with that agent, and only while
+// that chat is private to the user: their DM with the bot, or a non-public
+// group whose only members are the user and the bot. They are never sent to a
+// shared or public group, and never broadcast to the project's linked groups.
+
+import (
+	"context"
+	"strconv"
+	"strings"
+	"time"
+
+	"github.com/GoogleCloudPlatform/scion/pkg/messages"
+)
+
+const (
+	// The hub patch defines the same literals.
+	hubMirrorOriginKey     = "mirror_origin"
+	hubMirrorSenderNameKey = "sender_display_name"
+)
+
+// isHubMirror reports whether msg is a hub DM mirror copy.
+func isHubMirror(msg *messages.StructuredMessage) bool {
+	return msg != nil && msg.ObserverOnly && msg.Metadata[hubMirrorOriginKey] != ""
+}
+
+// hubMirrorableType reports whether a mirror copy of type t may be sent. The
+// hub mirrors only these conversational types (tgMirrorableType there).
+func hubMirrorableType(t string) bool {
+	switch t {
+	case messages.TypeInstruction, messages.TypeChat, messages.TypeReply:
+		return true
+	}
+	return false
+}
+
+// resolveMirrorChats picks the chats for a hub DM mirror copy. The DM's user
+// is the sender for a mirrored web message and the recipient for a mirrored
+// agent reply. The copy goes to that user's last chat with the agent, and
+// only when mirrorChatIsPrivate confirms the chat is private to the user.
+// Users without a Telegram link, who cannot read the project, or without a
+// chat with the agent get nothing, as do shared or unverifiable chats.
+func (b *TelegramBrokerV2) resolveMirrorChats(ctx context.Context, api *TelegramAPIClient, store Store, msg *messages.StructuredMessage, projectID, agentSlug string) []int64 {
+	principal, principalID := msg.Recipient, msg.RecipientID
+	if strings.HasPrefix(msg.Sender, "user:") {
+		principal, principalID = msg.Sender, msg.SenderID
+	}
+	email := strings.TrimPrefix(principal, "user:")
+	if email == principal {
+		return nil
+	}
+
+	mapping, err := store.GetUserMappingByEmail(ctx, email)
+	if (err != nil || mapping == nil) && principalID != "" {
+		mapping, err = store.GetUserMappingByScionUserID(ctx, principalID)
+	}
+	if err != nil || mapping == nil {
+		b.log.Debug("Hub mirror: DM user has no Telegram link, not sending", "principal", principal)
+		return nil
+	}
+
+	if ok, reason := b.recipientCanReadProject(ctx, mapping, projectID); !ok {
+		b.logReadDenial("Not mirroring to user's chat", reason, projectID)
+		return nil
+	}
+
+	cc, err := store.GetConversationContext(ctx, mapping.TelegramUserID, projectID, agentSlug)
+	if err != nil || cc == nil {
+		b.log.Debug("Hub mirror: DM user has no Telegram chat with the agent, not sending",
+			"project_id", projectID, "agent", agentSlug)
+		return nil
+	}
+	tgUserID, err := strconv.ParseInt(mapping.TelegramUserID, 10, 64)
+	if err != nil {
+		b.log.Debug("Hub mirror: DM user's Telegram link has an invalid user ID, not sending")
+		return nil
+	}
+	if !b.mirrorChatIsPrivate(ctx, api, cc.LastChatID, tgUserID) {
+		b.log.Debug("Hub mirror: DM user's last chat with the agent is not private to them, not sending",
+			"chat_id", cc.LastChatID, "agent", agentSlug)
+		return nil
+	}
+	return []int64{cc.LastChatID}
+}
+
+// mirrorPrivacyEntry is a cached mirrorChatIsPrivate decision for a group.
+type mirrorPrivacyEntry struct {
+	private   bool
+	failed    bool
+	checkedAt time.Time
+}
+
+// ttl returns how long the entry is reused.
+func (e mirrorPrivacyEntry) ttl() time.Duration {
+	if e.failed {
+		return mirrorPrivacyFailureTTL
+	}
+	return mirrorPrivacyCacheTTL
+}
+
+const (
+	// mirrorPrivacyCacheTTL bounds how long a group privacy decision is
+	// reused.
+	mirrorPrivacyCacheTTL = 2 * time.Minute
+	// mirrorPrivacyFailureTTL bounds how long a failed check is remembered;
+	// mirror copies to that chat are not sent meanwhile.
+	mirrorPrivacyFailureTTL = 30 * time.Second
+)
+
+func mirrorPrivacyKey(chatID, tgUserID int64) string {
+	return strconv.FormatInt(chatID, 10) + ":" + strconv.FormatInt(tgUserID, 10)
+}
+
+// mirrorChatIsPrivate reports whether chatID is private to the Telegram user
+// tgUserID. A private chat (positive ID) qualifies only when it is that
+// user's own chat with the bot. A group qualifies only when the user is a
+// current member, the chat has exactly two members, and it is a group or
+// supergroup without a public @username: anyone can read a public group, and
+// only members can query a non-public one, so the two members are the user
+// and this bot. Any failed check counts as not private (fail closed). Group
+// decisions are cached briefly; failed checks for a shorter time.
+func (b *TelegramBrokerV2) mirrorChatIsPrivate(ctx context.Context, api *TelegramAPIClient, chatID, tgUserID int64) bool {
+	if chatID > 0 {
+		return chatID == tgUserID
+	}
+	if chatID == 0 || api == nil {
+		return false
+	}
+
+	key := mirrorPrivacyKey(chatID, tgUserID)
+	if entry, ok := b.cachedMirrorPrivacy(key); ok {
+		return entry.private
+	}
+
+	if ctx.Err() != nil {
+		return false
+	}
+	entry := mirrorPrivacyEntry{checkedAt: time.Now()}
+	member, err := api.GetChatMember(ctx, chatID, tgUserID)
+	if err == nil && member.IsCurrentMember() {
+		var count int
+		count, err = api.GetChatMemberCount(ctx, chatID)
+		if err == nil && count == 2 {
+			var chat *TGChat
+			chat, err = api.GetChat(ctx, chatID)
+			entry.private = err == nil && chat.Username == "" &&
+				(chat.Type == "group" || chat.Type == "supergroup")
+		}
+	}
+	if err != nil {
+		if ctx.Err() != nil {
+			// The request ended with the caller's context; not remembered.
+			return false
+		}
+		// Includes the user or bot no longer seeing the chat
+		// (isNotVisibleChatError): not private either way.
+		b.log.Debug("Hub mirror: could not check whether the chat is private", "chat_id", chatID, "error", err)
+		entry.failed = true
+	}
+
+	b.mirrorPrivacyMu.Lock()
+	if b.mirrorPrivacy == nil {
+		b.mirrorPrivacy = make(map[string]mirrorPrivacyEntry)
+	}
+	for k, e := range b.mirrorPrivacy {
+		if time.Since(e.checkedAt) >= e.ttl() {
+			delete(b.mirrorPrivacy, k)
+		}
+	}
+	b.mirrorPrivacy[key] = entry
+	b.mirrorPrivacyMu.Unlock()
+	return entry.private
+}
+
+// cachedMirrorPrivacy returns the unexpired cached privacy decision for key.
+func (b *TelegramBrokerV2) cachedMirrorPrivacy(key string) (mirrorPrivacyEntry, bool) {
+	b.mirrorPrivacyMu.Lock()
+	defer b.mirrorPrivacyMu.Unlock()
+	e, ok := b.mirrorPrivacy[key]
+	if !ok || time.Since(e.checkedAt) >= e.ttl() {
+		return mirrorPrivacyEntry{}, false
+	}
+	return e, true
+}
