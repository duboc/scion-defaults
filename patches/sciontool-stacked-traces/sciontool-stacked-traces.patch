+		tp := sdktrace.NewTracerProvider(
+			sdktrace.WithSyncer(exp),
+			sdktrace.WithIDGenerator(telemetry.NewExplicitIDGenerator()),
+		)
+		h := NewTelemetryHandler(tp, nil, nil)
+		if err := h.Handle(ev); err != nil {
+			t.Fatalf("Handle(%s): %v", ev.Name, err)
+		}
+		exported = append(exported, exp.GetSpans()...)
+		_ = tp.Shutdown(context.Background())
+	}
+
+	runHookSubprocess(&hooks.Event{
+		Name: hooks.EventPromptSubmit,
+		Data: hooks.EventData{SessionID: "conv-1", Prompt: "hello"},
+	})
+	time.Sleep(5 * time.Millisecond)
+	runHookSubprocess(&hooks.Event{
+		Name: hooks.EventModelStart,
+		Data: hooks.EventData{SessionID: "conv-1"},
+	})
+	time.Sleep(10 * time.Millisecond)
+	runHookSubprocess(&hooks.Event{
+		Name: hooks.EventModelEnd,
+		Data: hooks.EventData{SessionID: "conv-1", InputTokens: 500, OutputTokens: 120, Success: true},
+	})
+	time.Sleep(5 * time.Millisecond)
+	runHookSubprocess(&hooks.Event{
+		Name: hooks.EventToolStart,
+		Data: hooks.EventData{SessionID: "conv-1", ToolName: "run_command"},
+	})
+	time.Sleep(15 * time.Millisecond)
+	// Antigravity PostToolUse omits ToolName; crossProcessEndSpan must recover it from PreToolUse.
+	runHookSubprocess(&hooks.Event{
+		Name: hooks.EventToolEnd,
+		Data: hooks.EventData{SessionID: "conv-1", ToolName: "", Success: true},
+	})
+	time.Sleep(5 * time.Millisecond)
+	runHookSubprocess(&hooks.Event{
+		Name: hooks.EventAgentEnd,
+		Data: hooks.EventData{SessionID: "conv-1", Success: true},
+	})
+
+	if len(exported) != 4 {
+		t.Fatalf("expected 4 exported spans (prompt, model-end, tool-end, turn-end), got %d", len(exported))
+	}
+
+	byName := map[string]tracetest.SpanStub{}
+	for _, s := range exported {
+		byName[s.Name] = s
+	}
+
+	root, ok := byName["agent.turn/frontend"]
+	if !ok {
+		t.Fatalf("missing root span agent.turn/frontend in %+v", byName)
+	}
+	if root.Parent.IsValid() {
+		t.Errorf("root span should have no parent, got %s", root.Parent.SpanID())
+	}
+	traceID := root.SpanContext.TraceID()
+	turnSpanID := root.SpanContext.SpanID()
+
+	for _, childName := range []string{
+		"agent.turn.prompt",
+		"gen_ai.api.response/Gemini_4_Argon_High",
+		"agent.tool.result/run_command",
+	} {
+		child, ok := byName[childName]
+		if !ok {
+			t.Fatalf("missing child span %q in %+v", childName, byName)
+		}
+		if child.SpanContext.TraceID() != traceID {
+			t.Errorf("%s TraceID = %s, want %s", childName, child.SpanContext.TraceID(), traceID)
+		}
+		if child.Parent.SpanID() != turnSpanID {
+			t.Errorf("%s ParentSpanID = %s, want %s", childName, child.Parent.SpanID(), turnSpanID)
+		}
+		if child.EndTime.Sub(child.StartTime) <= 0 {
+			t.Errorf("%s should have positive duration, got %v", childName, child.EndTime.Sub(child.StartTime))
+		}
+	}
+	if root.EndTime.Sub(root.StartTime) < 35*time.Millisecond {
+		t.Errorf("root span duration = %v, want >= 35ms covering whole turn", root.EndTime.Sub(root.StartTime))
+	}
+}
+
