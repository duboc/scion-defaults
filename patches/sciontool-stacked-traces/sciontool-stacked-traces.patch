+		attrs = append(attrs, attribute.Int64("gen_ai.usage.cached_tokens", st.CachedTokens))
+	}
+	if st.LastStatus != "" {
+		attrs = append(attrs, attribute.String("agent.status", st.LastStatus))
+	}
+	if st.PrevTraceID != "" {
+		attrs = append(attrs, attribute.String("scion.previous_trace_id", st.PrevTraceID))
+	}
+
+	startOpts := []trace.SpanStartOption{
+		trace.WithTimestamp(startTime),
+		trace.WithAttributes(attrs...),
+	}
