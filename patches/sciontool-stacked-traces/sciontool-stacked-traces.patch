+// EmitStatusTelemetry emits a child span and correlated log record for `sciontool status <type> <msg>`,
+// nested under the currently executing tool call (if any) or the active turn root span.
+func EmitStatusTelemetry(statusType, message string) {
+	if os.Getenv("SCION_AGENT_ID") == "" && os.Getenv("SCION_AGENT_SLUG") == "" {
+		return
+	}
+	cfg := telemetry.LoadConfig()
+	if cfg == nil || !cfg.Enabled {
+		return
+	}
+	ctx := context.Background()
+	providers, err := telemetry.NewProviders(ctx, cfg, false)
+	if err != nil || providers == nil {
+		return
+	}
+	defer func() {
+		shutdownCtx, cancel := context.WithTimeout(context.Background(), 3*time.Second)
+		defer cancel()
+		_ = providers.Shutdown(shutdownCtx)
+	}()
+
+	now := time.Now()
+	nowNano := now.UnixNano()
+	var traceIDHex, parentSpanIDHex, spanIDHex, sessionID string
+	var turnIdx int64
+
+	_ = telemetry.WithTraceState(func(st *telemetry.TraceState) error {
+		st.EnsureActiveTurn(nowNano, "", false)
+		traceIDHex = st.TraceID
+		parentSpanIDHex = st.TurnSpanID
+		if len(st.PendingTools) > 0 {
+			parentSpanIDHex = st.PendingTools[len(st.PendingTools)-1].SpanID
+		}
+		spanIDHex = telemetry.NewRandomSpanIDHex()
+		sessionID = st.SessionID
+		turnIdx = st.TurnIndex
+		st.LastStatus = statusType
+		st.LastStatusMsg = message
+		st.LastActivityNano = nowNano
+		return nil
+	})
+
+	h := NewTelemetryHandler(providers.TracerProvider, providers.LoggerProvider, telemetry.NewRedactor(cfg.Redaction))
+	spanCtx := context.Background()
+	if tid, okT := telemetry.ParseTraceIDHex(traceIDHex); okT {
+		if sid, okS := telemetry.ParseSpanIDHex(spanIDHex); okS {
+			if pid, okP := telemetry.ParseSpanIDHex(parentSpanIDHex); okP {
+				parentSC := trace.NewSpanContext(trace.SpanContextConfig{
+					TraceID:    tid,
+					SpanID:     pid,
+					TraceFlags: trace.FlagsSampled,
+					Remote:     true,
+				})
+				spanCtx = trace.ContextWithRemoteSpanContext(spanCtx, parentSC)
+			}
+			spanCtx = telemetry.ContextWithExplicitIDs(spanCtx, tid, sid)
+		}
+	}
+
+	displaySpanName := telemetry.StatusSpanName(statusType)
+	attrs := []attribute.KeyValue{
+		attribute.String("event.name", "agent.status"),
+		attribute.String("agent.status", statusType),
+		attribute.String("message", message),
+		attribute.Bool("success", true),
+	}
+	if sessionID != "" {
+		attrs = append(attrs, attribute.String("session_id", sessionID))
+	}
+	if turnIdx > 0 {
+		attrs = append(attrs, attribute.Int64("turn.index", turnIdx))
+	}
+
+	startTime := now.Add(-2 * time.Millisecond)
+	spanCtx, span := h.tracer.Start(spanCtx, displaySpanName, trace.WithTimestamp(startTime), trace.WithAttributes(attrs...))
+	h.emitLogRecord(spanCtx, &hooks.Event{
+		Name: "agent.status",
+		Data: hooks.EventData{
+			SessionID: sessionID,
+			Message:   message,
+			Reason:    statusType,
+			Success:   true,
+		},
+	}, "agent.status")
+	span.SetStatus(codes.Ok, "")
+	span.End(trace.WithTimestamp(now))
 }
 
