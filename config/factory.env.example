# Factory configuration.
# Copy this file to `factory.env` in the same folder and fill in your values.
# `factory.env` is git-ignored (the repo ignores `*.env`), so real project IDs,
# emails and URLs never land in Git. Every script in ../scripts reads it.

# --- Scion Hub (self-hosted on a GCE VM) ---
HUB_PROJECT=my-hub-project            # GCP project that hosts the Hub VM
HUB_ZONE=us-central1-c
HUB_VM=scion-hub                      # VM name, used with `gcloud compute ssh`
HUB_OS_USER=scion                     # OS user that runs `scion server` and owns ~/.scion
HUB_LOCAL_URL=http://localhost:8080   # Hub API as seen from the VM itself

# --- GCP sandbox the agents build and deploy into ---
SANDBOX_PROJECT=my-sandbox-project
SANDBOX_REGION=us-central1
SPANNER_INSTANCE=psearch-instance
SPANNER_DATABASE=psearch-db
BQ_DATASET=psearch_dataset
DATA_BUCKET=my-sandbox-project-factory-data
DEPLOYER_SA_NAME=agent-deployer       # identity of the deployer agents (Scion "assign" GCP identity mode)
RUNTIME_SA_NAME=psearch-serving       # dedicated Cloud Run runtime identity of the product service
SERVING_SERVICE=psearch-serving       # Cloud Run service built by the factory
DASHBOARD_SERVICE=psearch-eval-dashboard

# --- Factory ---
GITHUB_REPO=my-org/my-factory-repo
BUILD_PROJECT=psearch                 # Scion project that builds the product from GitHub issues
EVAL_PROJECT=psearch-eval             # Scion project that observes and evaluates the build factory
BUILD_BRANCH=main
EVAL_BRANCH=eval-dashboard
PO_EMAIL=po@example.com               # Hub admin account used as the product owner (PO)

# --- Optional Overrides ---
# FACTORY_PROJECTS=psearch,psearch-eval    # Comma-separated list of Scion project slugs to sync (default: $BUILD_PROJECT,$EVAL_PROJECT)
# BILLING_PROJECT=my-billing-project      # GCP project charged for Spanner/BigQuery API quota (default: $SANDBOX_PROJECT)
# HUB_VM_SA=scion-hub-sa@...              # Full SA email of the Hub VM (default: derived from GCE instance metadata)
# DASHBOARD_RUNTIME_SA=eval-dash-sa@...   # Full SA email for the eval dashboard Cloud Run service (default: derived)
# BQ_LOCATION=US                          # BigQuery dataset location (default: US)
# PRUNE_MINUTES=10                        # Minutes of inactivity before stale agent status rows are pruned in Spanner (default: 10)
# BACKUP_DIR=/home/scion/backups          # Hub VM backup storage directory (default: $HOME/backups)
# RETENTION_DAYS=14                       # Days to retain Hub database and state archives (default: 14)
# HUB_MONTHLY_BUDGET_USD=150              # Monthly budget alert threshold for Hub GCP project in USD (default: 150)
# SANDBOX_MONTHLY_BUDGET_USD=150          # Monthly budget alert threshold for Sandbox GCP project in USD (default: 150)
# MAX_RESTARTS_PER_HOUR=3                 # Max agent automatic restarts per hour before circuit breaker triggers (default: 3)

