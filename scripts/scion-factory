#!/usr/bin/env bash
set -euo pipefail
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
case "${1:-}" in
  doctor|list-roles|-h|--help|"")
    exec python3 "$SCRIPT_DIR/scion_factory.py" "$@"
    ;;
esac
if command -v uv >/dev/null 2>&1; then
  exec uv run --quiet --with pyyaml python3 "$SCRIPT_DIR/scion_factory.py" "$@"
else
  exec python3 "$SCRIPT_DIR/scion_factory.py" "$@"
fi
